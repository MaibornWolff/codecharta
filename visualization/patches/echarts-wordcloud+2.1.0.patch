# echarts-wordcloud 2.1.0 is effectively unmaintained (last release 2022-08), so these two upstream
# defects are patched here rather than waited on. Both are reproducible in the published 2.1.0 source
# and are re-verified by the domain-view e2e suite; re-check them before bumping the dependency.
#
#   1. src/layout.js  - sendEvent() builds a CustomEvent without `cancelable`, so preventDefault() is
#                       inert and the abort check can never fire (upstream: ecomfe/echarts-wordcloud).
#   2. src/wordCloud.js - a notMerge setOption replaces the series model, orphaning a running layout
#                       that then competes with its successor for the canvas.
#
diff --git a/node_modules/echarts-wordcloud/src/layout.js b/node_modules/echarts-wordcloud/src/layout.js
index e4ee4cf..0aa3fcc 100644
--- a/node_modules/echarts-wordcloud/src/layout.js
+++ b/node_modules/echarts-wordcloud/src/layout.js
@@ -1106,7 +1106,10 @@ var WordCloud = function WordCloud(elements, options) {
   var sendEvent = function sendEvent(type, cancelable, details) {
     if (cancelable) {
       return !elements.some(function (el) {
+        // Without `cancelable: true`, preventDefault() is a no-op and dispatchEvent always returns
+        // true — the loop's abort check can then never fire, so a disposed layout keeps running.
         var event = new CustomEvent(type, {
+          cancelable: true,
           detail: details || {}
         });
         return !el.dispatchEvent(event);
diff --git a/node_modules/echarts-wordcloud/src/wordCloud.js b/node_modules/echarts-wordcloud/src/wordCloud.js
index fbdf574..1a51df7 100644
--- a/node_modules/echarts-wordcloud/src/wordCloud.js
+++ b/node_modules/echarts-wordcloud/src/wordCloud.js
@@ -158,6 +158,17 @@ echarts.registerLayout(function (ecModel, api) {
       seriesModel.layoutInstance.dispose();
     }
 
+    // A notMerge setOption replaces the series model, so the layoutInstance above is undefined even
+    // when a layout is still running — that layout would keep placing words in the background and
+    // starve the new one. Track the running layout per chart (api is chart-scoped) so it is always
+    // disposed when its successor starts.
+    var runningLayouts = (api.__wordCloudRunningLayouts =
+      api.__wordCloudRunningLayouts || {});
+    var runningLayoutKey = seriesModel.seriesIndex;
+    if (runningLayouts[runningLayoutKey]) {
+      runningLayouts[runningLayoutKey].dispose();
+    }
+
     seriesModel.layoutInstance = {
       ondraw: null,
 
@@ -170,6 +181,7 @@ echarts.registerLayout(function (ecModel, api) {
         });
       }
     };
+    runningLayouts[runningLayoutKey] = seriesModel.layoutInstance;
   });
 });
 
