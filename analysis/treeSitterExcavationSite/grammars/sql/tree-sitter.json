{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sql_island",
      "camelcase": "SqlIsland",
      "title": "SQL island grammar",
      "scope": "source.sql",
      "path": ".",
      "file-types": ["sql", "pks", "pkb", "pls"]
    }
  ],
  "metadata": {
    "version": "0.7.0",
    "license": "BSD-3-Clause",
    "description": "Island grammar for SQL of all common dialects, exact for what CodeCharta measures",
    "authors": [{ "name": "MaibornWolff GmbH" }],
    "links": { "repository": "https://github.com/MaibornWolff/codecharta" }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
