# Default behavior, in case someone does not have core.autocrlf set.
* text eol=lf

# Files that should be normalized and converted.
gradlew.bat text eol=crlf
*.md text
*.json text
*.ts
*.py
*.yaml
*.java
*.kt
*.txt
*.csv

# Denote all files that are truly binary and should not be modified.
*.jar binary
*.dll binary
*.png binary
*.jpg binary
*.gif binary
*.icns binary
*.ico binary
*.eot binary
*.ttf binary
*.woff binary
*.woff2 binary

# Parsers generated by tree-sitter from grammar.js
analysis/treeSitterExcavationSite/grammars/*/src/parser.c linguist-generated=true -diff
analysis/treeSitterExcavationSite/grammars/*/src/grammar.json linguist-generated=true
analysis/treeSitterExcavationSite/grammars/*/src/node-types.json linguist-generated=true
analysis/treeSitterExcavationSite/grammars/*/src/tree_sitter/** linguist-generated=true
