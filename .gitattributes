# Default behavior, in case someone does not have core.autocrlf set.
* text eol=lf

# Files that should be normalized and converted.
gradlew.bat text eol=crlf
# Stored with Windows line endings, which the VBA editor needs to import a module, also when downloaded raw
analysis/script/access-export/*.bas -text
*.md text
*.json text
*.ts
*.py
*.yaml
*.java
*.kt
*.txt
*.csv

# Denote all files that are truly binary and should not be modified.
*.jar binary
*.dll binary
*.png binary
*.jpg binary
*.gif binary
*.icns binary
*.ico binary
*.eot binary
*.ttf binary
*.woff binary
*.woff2 binary
